<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Received_Date_Required</fullName>
    <active>true</active>
    <description>상태가 "수령"이면 수령일을 반드시 입력하도록 합니다.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;수령&quot;), ISBLANK(Received_Date__c))</errorConditionFormula>
    <errorDisplayField>Received_Date__c</errorDisplayField>
    <errorMessage>상태를 &quot;수령&quot;으로 바꾸려면 수령일을 입력해 주세요.</errorMessage>
</ValidationRule>
